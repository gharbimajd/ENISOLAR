# =================================================================
# ENISOLAR Environment Configuration Template
# Copy this file to .env and configure for your local/remote environment.
# Never commit .env or sensitive credentials to public repositories!
# =================================================================

# Backend REST API Endpoint
API_URL=http://enisolardienicar.atwebpages.com/

# HiveMQ Cloud MQTT Broker
MQTT_HOSTNAME=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8884
MQTT_PATH=/mqtt
MQTT_PROTOCOL=wss
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password

# Mapbox Access Token (if using Mapbox GL satellite views)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
